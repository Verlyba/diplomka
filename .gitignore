# Lokální prostředí a instalace LeRobota — obnoví se z README (kroku 1 v Setupu)
.venv*/
venv/
__pycache__/
*.pyc

# Uživatelská konfigurace (porty, ID ramen, cesty) — generuje se na stránce Setup
config.json
projects/

# Lokální nastavení nástrojů (obsahuje absolutní cesty k tomuhle stroji)
.claude/

# Záznamy běhů orchestrace
runs/*.json

# Strukturovaná telemetrie z inference_daemon.py (load/slope/trend za tik)
telemetry/

# LeRobot datasety a checkpointy, kdyby vznikly uvnitř projektu
outputs/
local/

# Editor/OS
.vscode/
.idea/
Thumbs.db
.DS_Store
